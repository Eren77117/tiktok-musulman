generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum PostStatus {
  PENDING
  ACTIVE
  REMOVED
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  MENTION
  LIVE_START
  MESSAGE_REQUEST
  MESSAGE_REQUEST_ACCEPTED
  SYSTEM
}

enum ConversationRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id                String   @id @default(uuid())
  username          String   @unique
  email             String   @unique
  password_hash     String
  display_name      String
  bio               String?
  bio_links         String[]
  profile_category  String?
  avatar_url        String?
  cover_url         String?
  gender            Gender
  role              Role     @default(USER)
  is_verified       Boolean  @default(false)
  is_banned         Boolean  @default(false)
  ban_reason        String?
  follower_count    Int      @default(0)
  following_count   Int      @default(0)
  post_count        Int      @default(0)
  like_count        Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  refresh_tokens    RefreshToken[]
  posts             Post[]
  stories           Story[]
  comments          Comment[]
  likes             Like[]
  follows_given     Follow[]          @relation("follower")
  follows_received  Follow[]          @relation("following")
  favorites         Favorite[]
  post_views        PostView[]
  blocked_users     BlockedUser[] @relation("blocker")
  blocked_by        BlockedUser[] @relation("blocked")
  hidden_users      HiddenUser[]  @relation("hider")
  hidden_by_users   HiddenUser[]  @relation("hidden_by")
  notifications     Notification[]
  sent_requests     ConversationRequest[] @relation("requester")
  received_requests ConversationRequest[] @relation("recipient")
  sent_messages     Message[]         @relation("sender")
  live_sessions     LiveSession[]
  live_messages     LiveMessage[]
  books             Book[]
  book_likes        BookLike[]
  reports_filed     Report[]          @relation("reporter")
  reports_against   Report[]          @relation("reported_user")
  audit_logs        AuditLog[]
  support_tickets   SupportTicket[]
  reposts           Repost[]
  not_interested    NotInterested[]
  story_views       StoryView[]
  story_likes       StoryLike[]
  story_replies     StoryReply[]  @relation("StoryReplySender")
  collections        Collection[]
  series             Series[]
  live_watch_history LiveWatchHistory[]
  hashtag_follows    HashtagFollow[]

  @@index([username])
  @@index([email])
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  user_id    String
  expires_at DateTime
  created_at DateTime @default(now())
  revoked    Boolean  @default(false)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token])
}

model Post {
  id            String     @id @default(uuid())
  user_id       String
  video_url     String
  thumbnail_url String?
  caption       String?
  duration      Float
  view_count    Int        @default(0)
  like_count    Int        @default(0)
  comment_count Int        @default(0)
  share_count   Int        @default(0)
  status        PostStatus @default(ACTIVE)
  is_public     Boolean    @default(true)
  sound_id      String?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  user      User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  sound     Sound?     @relation(fields: [sound_id], references: [id])
  comments  Comment[]
  likes     Like[]
  reply_to_id   String?
  reply_to      Post?    @relation("thread_replies", fields: [reply_to_id], references: [id])
  replies       Post[]   @relation("thread_replies")
  favorites   Favorite[]
  reports     Report[]
  post_views  PostView[]
  post_categories PostCategory[]
  reposts        Repost[]
  not_interested NotInterested[]
  linked_stories Story[]         @relation("StoryLinkedPost")
  collection_posts CollectionPost[]
  series_episode   SeriesEpisode?
  shared_in_messages Message[] @relation("SharedPost")

  @@index([user_id])
  @@index([created_at])
  @@index([status])
}

model Sound {
  id          String   @id @default(uuid())
  title       String
  artist      String?
  url         String
  duration    Float
  use_count   Int      @default(0)
  is_trending Boolean  @default(false)
  created_at  DateTime @default(now())

  posts Post[]

  @@index([is_trending])
}

model Category {
  id         String @id @default(uuid())
  name       String @unique
  slug       String @unique
  icon_url   String?
  post_count Int    @default(0)

  post_categories PostCategory[]

  @@index([slug])
}

model PostCategory {
  post_id     String
  category_id String

  post     Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@id([post_id, category_id])
}

model Story {
  id             String   @id @default(uuid())
  user_id        String
  media_url      String
  media_type     String   @default("image")
  duration       Int      @default(5)
  view_count     Int      @default(0)
  like_count     Int      @default(0)
  archived       Boolean  @default(false)
  expires_at     DateTime
  created_at     DateTime @default(now())
  linked_post_id String?

  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  views       StoryView[]
  likes       StoryLike[]
  replies     StoryReply[]
  linked_post Post?        @relation("StoryLinkedPost", fields: [linked_post_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([expires_at])
}

model StoryView {
  id         String   @id @default(uuid())
  story_id   String
  viewer_id  String
  created_at DateTime @default(now())

  story  Story @relation(fields: [story_id], references: [id], onDelete: Cascade)
  viewer User  @relation(fields: [viewer_id], references: [id], onDelete: Cascade)

  @@unique([story_id, viewer_id])
}

model StoryLike {
  id         String   @id @default(uuid())
  story_id   String
  user_id    String
  created_at DateTime @default(now())

  story Story @relation(fields: [story_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([story_id, user_id])
}

model StoryReply {
  id         String   @id @default(uuid())
  story_id   String
  sender_id  String
  content    String
  created_at DateTime @default(now())

  story  Story @relation(fields: [story_id], references: [id], onDelete: Cascade)
  sender User  @relation("StoryReplySender", fields: [sender_id], references: [id], onDelete: Cascade)
}

model Comment {
  id            String   @id @default(uuid())
  post_id       String
  user_id       String
  parent_id     String?
  content       String
  like_count    Int      @default(0)
  is_pinned     Boolean  @default(false)
  creator_liked Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  post     Post      @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("replies", fields: [parent_id], references: [id])
  replies  Comment[] @relation("replies")
  likes    Like[]

  @@index([post_id])
  @@index([user_id])
}

model Like {
  id         String   @id @default(uuid())
  user_id    String
  post_id    String?
  comment_id String?
  created_at DateTime @default(now())

  user    User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [post_id], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [comment_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id])
  @@unique([user_id, comment_id])
  @@index([user_id])
}

model Follow {
  id           String   @id @default(uuid())
  follower_id  String
  following_id String
  created_at   DateTime @default(now())

  follower  User @relation("follower", fields: [follower_id], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [following_id], references: [id], onDelete: Cascade)

  @@unique([follower_id, following_id])
  @@index([follower_id])
  @@index([following_id])
}

model BlockedUser {
  id         String   @id @default(uuid())
  blocker_id String
  blocked_id String
  created_at DateTime @default(now())

  blocker User @relation("blocker", fields: [blocker_id], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blocked_id], references: [id], onDelete: Cascade)

  @@unique([blocker_id, blocked_id])
  @@index([blocker_id])
}

model HiddenUser {
  id         String   @id @default(uuid())
  user_id    String
  hidden_id  String
  created_at DateTime @default(now())

  user   User @relation("hider", fields: [user_id], references: [id], onDelete: Cascade)
  hidden User @relation("hidden_by", fields: [hidden_id], references: [id], onDelete: Cascade)

  @@unique([user_id, hidden_id])
  @@index([user_id])
}

model Favorite {
  id         String   @id @default(uuid())
  user_id    String
  post_id    String
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id])
  @@index([user_id])
}

model PostView {
  id            String   @id @default(uuid())
  user_id       String
  post_id       String
  watch_time_ms Int      @default(0)
  completed     Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id])
  @@index([user_id])
  @@index([post_id])
}

model Notification {
  id          String           @id @default(uuid())
  user_id     String
  type        NotificationType
  title       String
  body        String
  data        Json?
  is_read     Boolean          @default(false)
  created_at  DateTime         @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@index([created_at])
}

model ConversationRequest {
  id           String                    @id @default(uuid())
  requester_id String
  recipient_id String
  status       ConversationRequestStatus @default(PENDING)
  created_at   DateTime                  @default(now())
  updated_at   DateTime                  @updatedAt

  requester    User            @relation("requester", fields: [requester_id], references: [id], onDelete: Cascade)
  recipient    User            @relation("recipient", fields: [recipient_id], references: [id], onDelete: Cascade)
  conversation Conversation?

  @@unique([requester_id, recipient_id])
  @@index([recipient_id, status])
}

model Conversation {
  id          String   @id @default(uuid())
  request_id  String   @unique
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  request  ConversationRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id              String   @id @default(uuid())
  conversation_id String
  sender_id       String
  content         String
  media_url       String?
  shared_post_id  String?
  is_read         Boolean  @default(false)
  metadata        Json?
  created_at      DateTime @default(now())

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       User         @relation("sender", fields: [sender_id], references: [id], onDelete: Cascade)
  shared_post  Post?        @relation("SharedPost", fields: [shared_post_id], references: [id], onDelete: SetNull)

  @@index([conversation_id, created_at])
  @@index([sender_id])
}

model LiveSession {
  id             String    @id @default(uuid())
  user_id        String
  title          String
  category       String    @default("general")
  stream_key     String    @unique @default(uuid())
  thumbnail_url  String?
  viewer_count   Int       @default(0)
  peak_viewers   Int       @default(0)
  is_active      Boolean   @default(true)
  chat_enabled   Boolean   @default(true)
  is_public      Boolean   @default(true)
  started_at     DateTime  @default(now())
  ended_at       DateTime?

  user     User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages      LiveMessage[]
  watch_history LiveWatchHistory[]
  mutes         LiveMute[]
  bans          LiveBan[]

  @@index([user_id])
  @@index([is_active])
}

model LiveMessage {
  id         String   @id @default(uuid())
  session_id String
  user_id    String
  content    String
  is_deleted Boolean  @default(false)
  created_at DateTime @default(now())

  session LiveSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([session_id, created_at])
}

model Book {
  id           String   @id @default(uuid())
  user_id      String
  title        String
  author       String?
  cover_url    String?
  summary      String
  content_url  String?
  category     String   @default("general")
  like_count   Int      @default(0)
  save_count   Int      @default(0)
  view_count   Int      @default(0)
  is_public    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user  User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  likes BookLike[]

  @@index([user_id])
  @@index([created_at])
}

model BookLike {
  id         String   @id @default(uuid())
  user_id    String
  book_id    String
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  book Book @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@unique([user_id, book_id])
  @@index([user_id])
}

model Report {
  id               String       @id @default(uuid())
  reporter_id      String
  reported_user_id String?
  reported_post_id String?
  reason           String
  description      String?
  status           ReportStatus @default(PENDING)
  moderator_note   String?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  reporter      User  @relation("reporter", fields: [reporter_id], references: [id])
  reported_user User? @relation("reported_user", fields: [reported_user_id], references: [id])
  reported_post Post? @relation(fields: [reported_post_id], references: [id])

  @@index([status])
  @@index([created_at])
}

model AuditLog {
  id         String   @id @default(uuid())
  user_id    String?
  action     String
  entity     String
  entity_id  String?
  metadata   Json?
  ip_address String?
  created_at DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([created_at])
  @@index([action])
}

model SupportTicket {
  id          String        @id @default(uuid())
  user_id     String
  subject     String
  description String
  status      TicketStatus  @default(OPEN)
  admin_reply String?
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
}

model Repost {
  id         String   @id @default(uuid())
  user_id    String
  post_id    String
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id])
  @@index([user_id])
  @@index([post_id])
}

model NotInterested {
  id         String   @id @default(uuid())
  user_id    String
  post_id    String
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id])
  @@index([user_id])
}

model Collection {
  id            String   @id @default(cuid())
  name          String
  user_id       String
  thumbnail_url String?
  created_at    DateTime @default(now())

  user  User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  posts CollectionPost[]

  @@unique([user_id, name])
  @@index([user_id])
}

model CollectionPost {
  collection_id String
  post_id       String
  saved_at      DateTime @default(now())

  collection Collection @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  post       Post       @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@id([collection_id, post_id])
  @@index([collection_id])
}

model Series {
  id          String   @id @default(cuid())
  user_id     String
  title       String
  description String?
  thumbnail_url String?
  episode_count Int    @default(0)
  created_at  DateTime @default(now())

  user     User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  episodes SeriesEpisode[]

  @@index([user_id])
}

model SeriesEpisode {
  id         String   @id @default(cuid())
  series_id  String
  post_id    String   @unique
  episode_num Int
  created_at DateTime @default(now())

  series Series @relation(fields: [series_id], references: [id], onDelete: Cascade)
  post   Post   @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@index([series_id])
  @@unique([series_id, episode_num])
}

model UserVideoAnalytics {
  id               String   @id @default(cuid())
  user_id          String
  post_id          String
  watch_time       Float    @default(0)
  watch_percent    Float    @default(0)
  rewatch_count    Int      @default(0)
  was_skipped      Boolean  @default(false)
  liked            Boolean  @default(false)
  commented        Boolean  @default(false)
  shared           Boolean  @default(false)
  saved            Boolean  @default(false)
  session_id       String?
  created_at       DateTime @default(now())

  @@index([user_id])
  @@index([post_id])
  @@index([created_at])
}

model AlgoConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Float
  description String?
  updated_at  DateTime @updatedAt

  @@index([key])
}

model LiveWatchHistory {
  id         String      @id @default(cuid())
  viewer_id  String
  session_id String
  watched_at DateTime    @default(now())

  viewer  User        @relation(fields: [viewer_id], references: [id], onDelete: Cascade)
  session LiveSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@unique([viewer_id, session_id])
  @@index([viewer_id])
  @@index([session_id])
}

model LiveMute {
  id         String      @id @default(cuid())
  session_id String
  user_id    String
  expires_at DateTime
  created_at DateTime    @default(now())

  session LiveSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
}

model LiveBan {
  id         String      @id @default(cuid())
  session_id String
  user_id    String
  created_at DateTime    @default(now())

  session LiveSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@unique([session_id, user_id])
  @@index([session_id])
}

model HashtagFollow {
  user_id    String
  tag        String
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, tag])
  @@index([tag])
}
